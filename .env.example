# 本地开发示例；复制为 .env 后可自行更换数据库密码和初始管理员密码。
MYSQL_ROOT_PASSWORD=MaydayRoot_2026_local
MYSQL_DATABASE=mayday
MYSQL_USER=mayday
MYSQL_PASSWORD=MaydayDb_2026_local
ADMIN_PASSWORD=Mayday@2026
# 新项目默认纯净初始化；仅体验演示时改 true，已有库不会因此增删数据。
SEED_DEMO_DATA=false
DB_PORT=13306
API_PORT=18080
WEB_PORT=15173
# Docker 的 UDP 映射，需与页面中接收端口一致；默认仅本机可发包，局域网部署改为宿主网卡 IP。
UDP_BIND_ADDRESS=127.0.0.1
UDP_LISTEN_PORT=19000

# 可选模块：关闭后接口返回 404、菜单及权限候选隐藏、后台轮询暂停；数据不删除。
# portal 依赖 content，approvals 依赖 notifications；关闭依赖同时关闭消费模块。
MODULE_CONTENT_ENABLED=true
MODULE_PORTAL_ENABLED=true
MODULE_NOTIFICATIONS_ENABLED=true
MODULE_APPROVALS_ENABLED=true
MODULE_CRAWLER_ENABLED=true
MODULE_SCHEDULER_ENABLED=true
MODULE_UDP_ENABLED=true
# 工单管理示例；按业务需要启用并授权，默认不展示。
MODULE_WORKORDERS_ENABLED=false
# generator:env-example
# 仅管理员能读取契约；生产环境可进一步关闭。
API_DOCS_ENABLED=true
