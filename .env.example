# 本地开发示例；复制为 .env 后可自行更换数据库密码和初始管理员密码。
MYSQL_ROOT_PASSWORD=MaydayRoot_2026_local
MYSQL_DATABASE=mayday
MYSQL_USER=mayday
MYSQL_PASSWORD=MaydayDb_2026_local
ADMIN_PASSWORD=Mayday@2026
# 新项目默认纯净初始化；仅体验演示时改 true，已有库不会因此增删数据。
SEED_DEMO_DATA=false
DB_PORT=13306
API_PORT=18080
WEB_PORT=15173
# Docker 的 UDP 映射，需与页面中接收端口一致；默认仅本机可发包，局域网部署改为宿主网卡 IP。
UDP_BIND_ADDRESS=127.0.0.1
UDP_LISTEN_PORT=19000
