<?xml version="1.0" encoding="utf-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>
  <groupId>com.mayday</groupId>
  <artifactId>mayday-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Mayday 模块化管理平台</name>
  <modules>
    <module>mayday-common</module>
    <module>mayday-system</module>
    <module>mayday-content</module>
    <module>mayday-security</module>
    <module>mayday-operations</module>
    <module>mayday-crawler</module>
    <module>mayday-netty</module>
    <module>mayday-workorders</module>
    <module>mayday-agentscope</module>
    <module>mayday-telegram</module>
    <!-- generator:maven-modules -->
    <module>mayday-application</module>
  </modules>
  <properties>
    <java.version>21</java.version>
    <!-- UDP 转发按约定锁定版本；统一解析，避免 Boot 将模块的传递依赖替换成另一版 Netty。 -->
    <netty.version>4.1.105.Final</netty.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <springdoc.version>3.0.3</springdoc.version>
    <!-- 所有 AgentScope Java 组件共享同一版本，避免核心与扩展间的二进制不兼容。 -->
    <agentscope.version>2.0.4</agentscope.version>
    <swagger-annotations.version>2.2.47</swagger-annotations.version>
    <spotless.version>2.44.3</spotless.version>
    <!-- 持久层统一使用 MyBatis-Flex；boot4 starter 与当前 Spring Boot 大版本配套。 -->
    <mybatis-flex.version>1.11.8</mybatis-flex.version>
    <!-- TDLight Java 与 native 必须来自同一发行版，避免 JNI 二进制与 Java API 不兼容。 -->
    <tdlight.version>3.5.7+td.1.8.68</tdlight.version>
    <tdlight.native.classifier>windows_amd64</tdlight.native.classifier>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.mybatis-flex</groupId>
        <artifactId>mybatis-flex-spring-boot4-starter</artifactId>
        <version>${mybatis-flex.version}</version>
      </dependency>
      <dependency>
        <groupId>it.tdlight</groupId>
        <artifactId>tdlight-java-bom</artifactId>
        <version>${tdlight.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <repositories>
    <repository>
      <id>tdlight</id>
      <url>https://mvn.mchv.eu/repository/mchv/</url>
    </repository>
  </repositories>
  <profiles>
    <profile>
      <id>tdlight-native-linux-amd64</id>
      <activation>
        <os>
          <family>unix</family>
          <arch>amd64</arch>
        </os>
      </activation>
      <properties>
        <tdlight.native.classifier>linux_amd64_gnu_ssl3</tdlight.native.classifier>
      </properties>
    </profile>
    <profile>
      <id>tdlight-native-macos-arm64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <tdlight.native.classifier>macos_arm64</tdlight.native.classifier>
      </properties>
    </profile>
  </profiles>
  <build>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <lineEndings>UNIX</lineEndings>
          <java>
            <!-- Mayday Java 标准：Eclipse JDT 执行 Allman/4空格/120列，规则来自 config/eclipse/Mayday-Java.prefs（对应 config/Mayday-Java-Standard.xml）。 -->
            <eclipse>
              <file>${maven.multiModuleProjectDirectory}/config/eclipse/Mayday-Java.prefs</file>
            </eclipse>
            <importOrder>
              <order>java,javax,jakarta,,\#</order>
            </importOrder>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>java-style</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
